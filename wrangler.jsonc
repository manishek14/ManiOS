{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manios",
  "compatibility_date": "2026-07-21",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": ["nodejs_compat"],
"services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "manios",
      "entrypoint": "worker"
    }
  ]
}
