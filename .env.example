# ─── Backend API ──────────────────────────────────────────────
# Base URL of the NestJS backend (Railway). Used by /api/chat,
# /api/contact and /api/admin/employers server routes.
BACKEND_URL=https://api.manishek.ir

# ─── Admin panel (server-side only!) ─────────────────────────
# NEVER prefix these with NEXT_PUBLIC_ — they must stay server-only.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Optional; if unset it is derived from ADMIN_PASSWORD
ADMIN_SESSION_SECRET=

# ─── Shared backend admin secret ─────────────────────────────
# Must match ADMIN_API_KEY in the backend (Railway). The frontend
# server routes use it as the `x-admin-key` header.
ADMIN_API_KEY=
